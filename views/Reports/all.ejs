<%- include('../partials/header') %>

<main>
    <main class="container py-4">
  <div class="row">
    <h1 class="text-center">Traffic Reports</h1>
    <div class="text-center">
      <a type="button" href="/" class="btn btn-primary btn-lg">Make a Traffic Report</a>
    </div>
    <div class="col-md-10 mx-auto">
      <table class="table table-bordered table-striped table-hover">
        <br>
        <tr>
          <th class="text-center col-2">Road</th>
          <th class="text-center col-2">Type</th>
          <th class="text-center col-2">Impact</th>
          <th class="text-center col-4">Description</th>
          <th class="text-center col-2">Status</th>
        </tr>
        <% for(let count = 0; count < allReports.length; count++){ %>
            <tr>
              <td class="text-center col-2"><%= allReports[count].road %></td>
              <td class="text-center col-2"><%= allReports[count].type %></td>
              <td class="text-center col-2"><%= allReports[count].impact %></td>
              <td class="text-center col-4"><%= allReports[count].description %></td>
              <td class="text-center col-4"><%= allReports[count].status %></td>
            </tr>
        <% } %>
      </table>
    </div>
  </div>
</main>
</main>

<%- include('../partials/footer') %>