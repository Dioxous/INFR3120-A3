<%- include('../partials/header') %>

<!--Form code from Bootstrap documentation-->

<main class="py-4">
    <div class="row justify-content-center mb-3">
      <h1 class="text-white text-center mb-3">Make a Traffic Report</h1>
      <div class="col-lg-10 px-3">
        <form class="row g-3 needs-validation justify-content-center" novalidate method="post"> 
          <div class="col-md-4">
            <label for="inputRoad" class="form-label">Road</label>
            <input type="text" class="form-control" id="inputRoad" name="road" required
              placeholder="Road/intersection of traffic">
          </div>
          <div class="col-md-4">
            <label for="inputType" class="form-label">Type</label>
            <input type="text" class="form-control" id="inputType" name="type" required
              placeholder="Closure, delay, incident, etc.">
          </div>
          <div class="col-md-2">
            <label for="inputImpact" class="form-label">Impact</label>
            <select class="form-select" id="inputImpact" name="impact" required>
              <option selected disabled value="">Choose...</option>
              <option>High</option>
              <option>Medium</option>
              <option>Low</option>
            </select>
          </div>
          <div class="col-md-8">
            <label for="inputDescription" class="form-label">Description</label>
            <textarea class="form-control" id="inputDescription" rows="3" name="description" required
              placeholder="Description of traffic"></textarea>
          </div>
          <div class="col-md-2">
            <label for="inputStatus" class="form-label">Status</label>
            <select class="form-select" id="inputStatus" name="status" required>
              <option selected disabled value="">Choose...</option>
              <option>Active</option>
              <option>Cleared</option>
            </select>
          </div>
          <div class="col-md-10">
            <button class="btn btn-success me-2" type="submit">Submit form</button>
            <a class="btn btn-danger" href="/reports">Cancel</a>
          </div>
        </form>
      </div>
    </div>
</main>

<script>
    (function () {
      'use strict'

      // Fetch all the forms we want to apply custom Bootstrap validation styles to
      var forms = document.querySelectorAll('.needs-validation')

      // Loop over them and prevent submission
      Array.prototype.slice.call(forms)
        .forEach(function (form) {
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }

            form.classList.add('was-validated')
          }, false)
        })
    })()
</script>

<%- include('../partials/footer') %>